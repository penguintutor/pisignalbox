{
    /***********************************************************
    * Do NOT edit this file directly                           *
    * custom settings should be in a file server.json          *
    ***********************************************************/

    // The serial port for the MERG CANUSB4 or other VLCB interface
    "usb_port": "/dev/ttyACM0",
    
    // Web server host (0.0.0.0 allows access from other devices on the network)
    "hostname": "0.0.0.0",
    
    // Flask web server port
    "tcp_port": 5000,

    /* Authentication */
    // If public access enabled then api_key and user_auth are not required
    // Recommend that this is set to false as it allows anyone to control
    // the layout without authentication
    "public_access_enable": false,

    // Is API key supported (if not then url_key must be added to server.json)
    "api_key_enable": true,
    // Do NOT store the API key here - instead use server.json
    // setting it blank will not work as there are minimim key requirements
    //"api_key": "",
    // The same api_key will also need to be added to the client settings.json

    // Are users able to login through a browser 
    // If not, and public access is not enabled then all connections
    // must be through the api
    "user_auth_enable": true

}